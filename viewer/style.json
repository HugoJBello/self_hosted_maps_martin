{
  "version": 8,
  "name": "Local OpenMapTiles Improved",
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "osm": {
      "type": "vector",
      "url": "http://localhost:3000/map"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#eef3f7"
      }
    },

    {
      "id": "landcover",
      "type": "fill",
      "source": "osm",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#dfe8d6"
      }
    },

    {
      "id": "landuse",
      "type": "fill",
      "source": "osm",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#e8ecd8"
      }
    },

    {
      "id": "water",
      "type": "fill",
      "source": "osm",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a9d3f5"
      }
    },

    {
      "id": "waterway",
      "type": "line",
      "source": "osm",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#8bbbe8",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5, 0.3,
          10, 1,
          14, 2
        ]
      }
    },

    {
      "id": "boundaries",
      "type": "line",
      "source": "osm",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#b7b7b7",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          3, 0.3,
          8, 0.8,
          12, 1.2
        ]
      }
    },

    {
      "id": "roads",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#777777",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5, 0.4,
          8, 0.8,
          10, 1.2,
          12, 2,
          14, 3,
          16, 5
        ]
      }
    },

    {
      "id": "roads-minor",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#999999",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10, 0.3,
          12, 0.8,
          14, 1.5,
          16, 3
        ]
      }
    },

    {
      "id": "buildings",
      "type": "fill",
      "source": "osm",
      "source-layer": "building",
      "minzoom": 12,
      "paint": {
        "fill-color": "#d8d1c3",
        "fill-opacity": 0.85
      }
    },

    {
      "id": "place-labels",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place",
      "layout": {
        "text-field": ["coalesce", ["get", "name:es"], ["get", "name"]],
        "text-font": ["Open Sans Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          4, 10,
          8, 12,
          12, 14
        ]
      },
      "paint": {
        "text-color": "#333333"
      }
    },

    {
      "id": "road-labels",
      "type": "symbol",
      "source": "osm",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:es"], ["get", "name"]],
        "text-font": ["Open Sans Regular"],
        "text-size": 11
      },
      "paint": {
        "text-color": "#555555"
      }
    }
  ]
}
